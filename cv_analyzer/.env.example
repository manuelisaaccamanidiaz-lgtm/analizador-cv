# Copia este archivo como .env (en esta carpeta) y llena al menos UN proveedor.
# En la barra lateral de la app solo aparecen los proveedores configurados.

# --- Gemini ---
GOOGLE_API_KEY=clave_configurada_localmente
GEMINI_MODEL=nombre_de_un_modelo_gemini_compatible
GEMINI_EMBEDDING_MODEL=nombre_de_un_modelo_de_embeddings_de_gemini

# --- OpenAI (opcional) ---
# OPENAI_API_KEY=clave_configurada_localmente
# OPENAI_MODEL=nombre_de_un_modelo_de_openai
# OPENAI_EMBEDDING_MODEL=nombre_de_un_modelo_de_embeddings_de_openai

# --- Ollama local (opcional, sin clave) ---
# OLLAMA_MODEL=nombre_de_un_modelo_de_chat_descargado_con_ollama_pull
# OLLAMA_EMBEDDING_MODEL=embeddinggemma
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Base de datos ---
# En Docker la define docker-compose.yml (PostgreSQL). Sin Docker se usa SQLite en datos/historial.db.
# DATABASE_URL=postgresql+psycopg://usuario:contrasena@servidor:5432/base
