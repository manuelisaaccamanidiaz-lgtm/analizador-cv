# OPCIONAL: credenciales de PostgreSQL del docker-compose.
# Copia como .env (en esta carpeta raíz) solo si quieres cambiar los valores por defecto.
# Si cambias la contraseña después de crear la base, borra el volumen: docker compose down -v
POSTGRES_USER=cv_app
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=cv_analyzer
